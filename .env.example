DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings. Changing provider, model or dimensions requires `rag-reindex`.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Generation: openai (e.g. gpt-4o-mini) or anthropic (e.g. claude-sonnet-5-5)
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-4o-mini

# Reranking: lexical (default) or cross-encoder (needs `.[local]`)
RERANK_PROVIDER=lexical
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# JWT verification for the existing application's tokens. Set JWKS_URL, or a PEM public key.
JWT_ISSUER=https://your-app.example
JWT_AUDIENCE=rag-support
JWT_JWKS_URL=https://your-app.example/.well-known/jwks.json
JWT_PUBLIC_KEY=
JWT_ALGORITHMS=RS256,ES256
ACCOUNT_CLAIM=account_id
ROLES_CLAIM=roles
ADMIN_ROLE=knowledge_admin

CORS_ORIGINS=https://kingnonso.github.io
MAX_UPLOAD_BYTES=20000000

# Retrieval and answering (calibrate MIN_RETRIEVAL_SCORE on labeled questions)
MIN_RETRIEVAL_SCORE=0.24
RETRIEVAL_CANDIDATES=12
CONTEXT_PASSAGES=6
CHUNK_MAX_CHARS=1300
CHUNK_OVERLAP=180
MAX_HISTORY_TURNS=6

# OCR quality flags
OCR_MIN_CHARS=40
OCR_MIN_CONFIDENCE=60

# Sessions older than this with no activity are removed by `rag-purge`
SESSION_RETENTION_DAYS=90
